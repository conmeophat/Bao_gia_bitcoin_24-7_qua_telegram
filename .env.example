# Telegram - create a bot with @BotFather
TELEGRAM_BOT_TOKEN=
# Your personal Telegram chat/user ID. Keep the bot private.
TELEGRAM_CHAT_ID=

# Persistent database path. On Railway, mount a volume at /data.
DATABASE_PATH=./data/alerts.sqlite3

# OKX public market data (no API key required)
OKX_REST_URL=https://openapi.okx.com
OKX_WS_URL=wss://ws.okx.com/ws/v5/public
OKX_INSTRUMENT_ID=BTC-USDT

# REST fallback interval in seconds
REST_POLL_INTERVAL_SECONDS=10
